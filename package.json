{
  "name": "webapp-forge",
  "version": "2.0.0",
  "description": "Turn any website into a desktop web app and pin it to your taskbar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "aminedeesucre",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.aminedeesucre.webapp-forge",
    "productName": "WebAppForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "ui/**",
      "assets/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  }
}
